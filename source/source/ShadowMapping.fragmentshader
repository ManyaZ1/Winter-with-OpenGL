void main() {   
    
    // If using the sky texture, output it directly and skip the rest
    if (useTexture == 3) {
        // spherical mapping in fragment shader
        vec3 p = normalize(fragPos_modelspace);

        float pi = 3.14159265358979323846;

        // NOTE: use atan(z,x) so longitude runs correctly around sphere
        float u = atan(p.z, p.x) / (2.0 * pi) + 0.5;
        float v = asin(clamp(p.y, -1.0, 1.0)) / pi + 0.5;

        // fold into [0,1), safe for repeat-wrapped texture
        u = 1-fract(u);
        v = 1-clamp(v, 0.0, 1.0);

        fragmentColor = vec4(texture(skyTex, vec2(u, v)).rgb, 1.0);
        
        fragmentColor.rgb = mix(fragmentColor.rgb, fogColor,  fogDensity );
        return;
    }

    //fog will be applied
    
    // Mode 4 for simple textured billboards (clouds)
    else if (useTexture == 4) {
        //vec4 texColor = texture(sunTex, vertex_UV);
        vec2 rotatedUV = vertex_UV;
        float cosA = cos(uvRotationAngle);
        float sinA = sin(uvRotationAngle);
        
        // 1. Center the UVs (shift [0,1] to [-0.5, 0.5])
        vec2 centeredUV = rotatedUV - 0.5;
        
        // 2. Apply 2x2 Rotation Matrix
        rotatedUV.x = centeredUV.x * cosA - centeredUV.y * sinA;
        rotatedUV.y = centeredUV.x * sinA + centeredUV.y * cosA;
        
        // 3. Shift back to [0, 1] range
        rotatedUV += 0.5;
        vec4 texColor = texture(sunTex, rotatedUV);
        // --- ADD THIS LOGIC (Alpha Test) ---
        // If the fragment is nearly transparent, discard it completely.
        // This removes the rectangular outline.
        if (texColor.a < 0.1) {
            discard;
        }
        // -----------------------------------
        
        fragmentColor = texColor; // Use RGB and Alpha directly
        //return;
    }

    // SUN (emissive sphere)
    else if (useTexture == 2) {
        vec4 sunColor = texture(sunTex, vertex_UV);
        fragmentColor = vec4(sunColor.rgb, 1.0);
    //return;
    }
    else {
    // --- LIGHT 1  ---
        float shadow1 = ShadowCalculation(vertex_position_lightspace, shadowMapSampler);
        float visibility1 = 1.0f - shadow1;
        //float visibility1 = 1.0;
        vec3 color1 = calculatePhong(light, vec4(0,0,0,1), visibility1); 
        fragmentColor = vec4(color1, 1.0);
    }
    float dist = length(vertex_position_cameraspace.xyz);
    float fogDensityScaled = fogDensity * 0.03;
    float fogFactor = 1.0 / exp((dist * fogDensityScaled) * (dist * fogDensityScaled));
    fogFactor = clamp(fogFactor, 0.0, 1.0);
    fragmentColor.rgb = mix(fogColor, fragmentColor.rgb, fogFactor);
    return;
}



float ShadowCalculation(vec4 fragPositionLightspace,sampler2D depthMap ) {

    // Given the position of a fragment in lightspace coordinates
    // We sample the depth buffer to see whether or not the fragment is shadowed
    
    float shadow;

    // Task 4.3
    
    // Perspective devide to bring coordinates in range[-1, 1]
    vec3 projCoords = fragPositionLightspace.xyz / fragPositionLightspace.w; //vec3 projCoords = vertex_position_lightspace.xyz / vertex_position_lightspace.w;

    // Since the depth map values are in range[0, 1]
    projCoords = projCoords*0.5f + 0.5f;

    // Sampling the closest point in this position from the depth map
    // REMINDER: Since we are in lightspace coordinates,
    //           the z parameter is the depth from the camera
    //float closestDepth = texture(shadowMapSampler, projCoords.xy).r;
    float closestDepth = texture(depthMap , projCoords.xy).r;
    // Then we get the depth of the current fragment
    float currentDepth = projCoords.z; //kanonas deksiou xerioy ara z einai pros ta mesa

    // If the current fragment is farther than the closest point, the fragment is shadowed
    //shadow = currentDepth > closestDepth  ? 1.0 : 0.0;
    //
    // Task 4.4
    // Correcting the quantization problem
    //float bias = 0.0015f; //0.0004
    // Dynamic bias based on surface angle
    vec3 normal = normalize(vertex_normal_cameraspace.xyz);
    vec3 lightDir = normalize(lightDir_cameraspace);
    float cosTheta = clamp(dot(normal, lightDir), 0.0, 1.0);
    float bias = 0.001 + 0.005 * (1.0 - cosTheta); 
    shadow = currentDepth > (closestDepth+bias)  ? 1.0 : 0.0;
        

    // Task 4.6 Make the shadow edges more realistic
    
    shadow = 0.0;
    //vec2 depthMap_dimensions = textureSize(shadowMapSampler, 0);
    vec2 depthMap_dimensions = textureSize(depthMap, 0);
    //vec2 texelSize = 1.0 / vec2(textureSize(depthMap, 0));
    vec2 texelSize = 1.0 / depthMap_dimensions;

    //vec2 texelSize = 1.0 / depthMap_dimensions;
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
    projCoords.y < 0.0 || projCoords.y > 1.0 ||
    projCoords.z > 1.0)
    {
     return 0.0; // fully lit
    }
    int pcfRange = 2;  // Was 1 - increase for softer shadows
    int samples = 0;
    
    for(int x = -pcfRange; x <= pcfRange; x++) {
        for(int y = -pcfRange; y <= pcfRange; y++) {
            float pcfDepth = texture(depthMap, projCoords.xy + vec2(x, y) * texelSize).r;
            shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
            samples++;
        }
    }
     shadow /= float(samples);

//    for(int x = -1; x <= 1; x++ ){
//        for(int y = -1; y <= 1; y++ ){
//            //float pcfDepth = texture(shadowMapSampler, projCoords.xy + vec2(x, y) * texelSize).r;
//            float pcfDepth = texture(depthMap, projCoords.xy + vec2(x, y) * texelSize).r;
//            shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
//            // oxi ! shadow += (currentDepth - bias < pcfDepth) ? 1.0 : 0.0;
//
//        }
//    }
//    shadow /= 9.0;
    
    if(projCoords.z > 1)
        shadow = 0.0;

    return shadow;
}
//float hash(vec3 p)
//{
//    p = fract(p * 0.3183099 + vec3(0.1));
//    p *= 17.0;
//    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
//}
    float hash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}
vec3 calculatePhong(Light lightData, vec4 lightPosCamera, float visibility) {
    vec4 _Ks = mtl.Ks;
    vec4 _Kd = mtl.Kd;
    vec4 _Ka = mtl.Ka;
    float _Ns = mtl.Ns;
    if (useTexture == 5) {// trees
        // Trunk or needles based on UV
        if (vertex_UV.x < 0.5) {
            // TRUNK: Bark (same for all instances)
            vec2 barkUV = vec2(vertex_UV.x * 2.0, vertex_UV.y) * vec2(6.0, 6.0); 
            _Kd.rgb = texture(trunkTex, barkUV).rgb;
        } else {
        // NEEDLES: Select texture based on instance index
            vec2 branchUV = vec2((vertex_UV.x - 0.5) * 2.0, vertex_UV.y) * vec2(5.0, 5.0); //*repetition factor
        
            vec4 texColor;
            // Switch between different needle textures based on textureIndex
            if (textureIndex == 0) {
                texColor = texture(needleTex, branchUV);      // tree2.jpg
            } else if (textureIndex == 1) {
                texColor = texture(needleTex2, branchUV);     // fir.jpg
            } else {
                //texColor = texture(needleTex2, branchUV);
                texColor = texture(needleTex3, branchUV);     // chrys.jpg
            }
        if (texColor.a < 0.1) discard; 
            _Kd.rgb = texColor.rgb;
    }
        _Ka.rgb = 0.07 * _Kd.rgb;
        _Ks.rgb = vec3(0.1); 
        _Ns = 5.0;
    }
    float lakeMask ;
    //float reflectionStrength =0.2; // Base reflection strength for water, can be adjusted or made dynamic
    

    if (useTexture == 1) {
        vec3 terrainColor = mix(
        texture(terrainTex, vertex_UV_tiled).rgb,
        texture(terrainTex2, vertex_UV_tiled).rgb,        0.3);
        

        // Calculate if this fragment is at/below water level
        float surfaceHeight = vertex_position_worldspace.y;
        //lakeMask = step(surfaceHeight, waterHeight);
        //vec3 bottomColor = mix(texture(waterTex2, vertex_UV).rgb, texture(bottomTex, vertex_UV).rgb, 0.3);
        //lakeMask = smoothstep(0.0, 1.0, texture(maskTex, vertex_UV).r);
        float maskValue = texture(maskTex, vertex_UV).r;
        lakeMask = (maskValue > 0.5 && surfaceHeight <= waterHeight) ? 1.0 : 0.0;
        // NEW: During reflection pass, discard water pixels
        if (renderingReflection == 1 && lakeMask > 0.5) {
            discard;  // Don't render water in reflection
        }
        vec3 waterColor;
        // Calculate freeze factor (0.0 = liquid, 1.0 = frozen)
        float freezeFactor = smoothstep(0.3, 0.7, snowAmount);
        
        if(freezeFactor < 0.8) {
            // Liquid or partially frozen water - apply animation
            // Reduce animation speed as water freezes
            //float animSpeed = 1.0 - freezeFactor;
            vec2 waterUV1 = vertex_UV + vec2(time * 0.005 , time * 0.005 );
            vec2 waterUV2 = vertex_UV + vec2(-time * 0.003 , time * 0.007 );
            waterColor = mix(texture(waterTex, waterUV1).rgb, texture(waterTex2, waterUV2).rgb, 0.3);

        }
        else {
            // Fully frozen - no animation
            waterColor = texture(waterTex, vertex_UV).rgb;
        }
         // Simulate freezing: desaturate and brighten the water color
        vec3 frozenColor = vec3(0.85, 0.90, 0.95); // Icy blue-white color
        
        // Calculate luminance for desaturation
        float luminance = dot(waterColor, vec3(0.299, 0.587, 0.114));
        vec3 desaturated = mix(waterColor, vec3(luminance), freezeFactor * 0.7);
        
        // Mix with frozen color
        waterColor = mix(desaturated, frozenColor, freezeFactor * 0.6);
        //float noise = texture(noiseTex, vertex_UV * 3.0).r;
        // 1. Create a "Milky" base using FBM or layered noise
        float baseNoise = texture(noiseTex, vertex_UV * 7.0).r;
        //float fineDetail = texture( snowDetailTex, vertex_UV * 100.0).r;
        float iceTexture = baseNoise;//mix(baseNoise, fineDetail, 0.3);

        // 2. Simulate "Cracks" or "Bubbles" (Using a high-contrast noise)
        //float bubbles = smoothstep(0.6, 0.7, fineDetail) * 0.3; 

        // 3. Apply to waterColor
        //  noise to add "whiteness" (frost) and "darkness" (depth)
        vec3 iceBase = mix(waterColor, vec3(0.9, 0.9, 1.0), iceTexture * 0.4);
        //iceBase += bubbles; // Add white flecks for trapped air

        waterColor = mix(waterColor, iceBase, freezeFactor);
        vec3 bottomColor = texture(bottomTex, vertex_UV).rgb;
        vec3 finalWater = mix(bottomColor, waterColor, 0.9);
        
        // NEW: Add reflection to water
        if (lakeMask > 0.5 ) {  // Only apply reflection to lake areas
            // Calculate screen-space UV coordinates for reflection
            vec2 screenUV = gl_FragCoord.xy / vec2(textureSize(reflectionTex, 0));
            vec2 waveDistortion;
            if(freezeFactor<0.99){
                // Add wave distortion to reflection based on water animation
                float wave1 = sin(time * 0.8 + vertex_UV.x * 15.0 + vertex_UV.y * 10.0);
                float wave2 = cos(time * 0.5 - vertex_UV.x * 8.0 + vertex_UV.y * 12.0);
                float wave3 = sin(time * 1.2 + vertex_UV.x * 20.0 - vertex_UV.y * 5.0);
    
                // Combine waves for more natural distortion
                waveDistortion = vec2(
                    (wave1 + wave2 * 0.5) * 0.01,
                    (wave2 + wave3 * 0.5) * 0.001);
            }
            else{ waveDistortion = vec2(0.0); // No distortion when frozen
            }
            vec2 reflectionUV = screenUV + waveDistortion;
            
            // Sample reflection texture
            vec3 reflectionColor = texture(reflectionTex, reflectionUV).rgb;
            
            // Blend reflection with water color based on reflectionStrength
//            if(freezeFactor >0.99){
//                reflectionStrength=0.8;
//            }
            finalWater = mix(finalWater, reflectionColor, reflectionStrength);
        }
        //lake mask
        _Kd.rgb = mix(terrainColor, finalWater, lakeMask);
        _Ka.rgb = 0.05 * _Kd.rgb;
        _Ks.rgb = _Kd.rgb  * mix(1.0, 0.2, freezeFactor);; // ROUGHER WHEN FROZEN
        _Ns = 10.0;
    }
    if (useTexture == 6) {// bush
        vec4 texColor;
        if (textureIndex == 0) { 
            texColor = texture(bushTex1, vertex_UV);      // tree2.jpg
        } else if (textureIndex == 1) {
            texColor = texture(bushTex2, vertex_UV);     // fir.jpg
        } else {
            texColor = texture(bushTex3, vertex_UV);     // chrys.jpg
        }
        if (texColor.a < 0.1) discard; 
        _Kd.rgb = texColor.rgb;
        _Ka.rgb = 0.05 * _Kd.rgb;
        _Ks.rgb = vec3(0.1); 
        _Ns = 7.0;
    }
    if (useTexture == 7) { // Animal Texture (Deer, Bear) + apple
        // Direct UV mapping using the diffuseColorSampler
        vec4 texColor = texture(diffuseColorSampler, vertex_UV);
        
        // Use the texture's RGB for the diffuse component
        _Kd.rgb = texColor.rgb;
        
        // Define material properties for fur/skin
        _Ka.rgb = 0.6 * _Kd.rgb; // Ambient intensity
        _Ks.rgb = vec3(0.1);      // specularity 
        _Ns = 3.0;               // Shininess factor
        
        // Optional: Discard if the texture has transparency 
        // (usually not needed for animal skins, but good for safety)
        if (texColor.a < 0.1) discard; 
    }
    float distToCamera = length(vertex_position_cameraspace.xyz);
    
    float detailFade = smoothstep(50.0, 10.0, distToCamera);

    // snowflakes
    //if (snowAmount > 0.01 && lakeMask < 0.5) {
    //    vec3 flakeGrid = floor(vertex_position_worldspace * 20.0);
    //    float birthThreshold = hash(flakeGrid);
    //    if (birthThreshold < snowAmount) {
    //        vec3 snowflakeColor = vec3(0.98, 0.98, 1.0);
    //        float strength = detailFade; 
    //        _Kd.rgb = mix(_Kd.rgb, snowflakeColor, strength);
    //    }
    //}
    if (detailFade > 0.01 && snowAmount > 0.01 && lakeMask < 0.5 ) { //&& snowAmount < 0.6 
        // 2. GRID-BASED SNOWFLAKES
        float gridScale = 2.0; 
        if (useTexture == 5 ||  useTexture == 6 || useTexture == 7 ){
            gridScale = 0.1; // sparser flakes 
        }
        vec3 n = normalize(Normal_worldspace);
        float upFactor = max(dot(n, vec3(0, 1, 0)), 0.0); // 1.0 (up), 0.0 (side), -1.0 (down)
        vec3 scaledWorld = vertex_position_worldspace * gridScale;
        //float adaptiveScale = mix(10.0, 5.0, upFactor); 
        //vec3 scaledWorld = vertex_position_worldspace * adaptiveScale;
        vec3 cellID = floor(scaledWorld);    
        float birthThreshold = hash(cellID) ;//delay
        //float flakeVisibility = smoothstep(0.01, 0.2, snowAmount) * (1.0 - smoothstep(0.4, 0.6, snowAmount));
        //if (birthThreshold < flakeVisibility)
        if (birthThreshold < snowAmount ) {
        // 3. SKY VISIBILITY (The expensive part)
            //vec4 fragPosSky = skyVP * vec4(vertex_position_worldspace, 1.0);
            //vec3 skyCoords = (fragPosSky.xyz / fragPosSky.w) * 0.5 + 0.5;
            //float skyDepth = texture(snowAccumMap, skyCoords.xy).r;
            //float skyVisible = (skyCoords.z - 0.001) < skyDepth ? 1.0 : 0.0;
            //float skyVisible=1; //flakes everywhere => NO EXPENSIVE MATH
      
            // We can allow flakes if the surface faces UP, even if skyVisible fails.
            // Appear if visible from sky OR if the surface is facing up (like branches)
            if ( upFactor > 0.7 ) {  //skyVisible>0.5
                vec3 cellUV = fract(scaledWorld) - 0.5; 
                float dist = length(cellUV);            
                // Define shape
                //float flakeSize = 0.3 + (hash(cellID + 1.0) * 0.15); 
                float angle = atan(cellUV.y, cellUV.x);
                float starMod = abs(cos(angle * 3.0)+cos(angle * 13));//cos(angle * 6.0); 
                float snowflakeDist = dist / (1.0 + 0.4 * starMod);
                float flakeSize = 0.1 + (hash(cellID + 1.0) * 0.1); 
                float shape = smoothstep(flakeSize, flakeSize - 0.05, snowflakeDist);
                //float shape = smoothstep(flakeSize, flakeSize - 0.05, dist);
                // Final blend
                vec3 flakeColor = vec3(0.85,0.9,1.0);
                float finalAlpha = shape * detailFade; // detailFade kills distant flakes
                _Kd.rgb = mix(_Kd.rgb, flakeColor, finalAlpha);
            }
        }
     }
     if (snowAmount > 0.05 && lakeMask<0.5) {  //SNOWLEVEL=SNOWAMOUT=0.1 => menas 5 accumulation time 
        // Transform fragment position to sky-space
        vec4 fragPosSky = skyVP * vec4(vertex_position_worldspace, 1.0);
        vec3 skyCoords = (fragPosSky.xyz / fragPosSky.w) * 0.5 + 0.5;
        
        // Check if this fragment is visible from the sky // (comparing depth values like shadow mapping)
        float skyDepth = texture(snowAccumMap, skyCoords.xy).r;
        float fragDepth = skyCoords.z;
        float skyVisible = (fragDepth - 0.001) < skyDepth ? 1.0 : 0.0; // Small bias
        
        // Only accumulate on upward-facing surfaces                    //vec3 worldNormal = normalize(vertex_normal_cameraspace.xyz); //float normalFactor = max(dot(worldNormal, vec3(0, 1, 0)), 0.0); 
        //1.0 (Same Direction), 0.0 (Perpendicular) //-1.0 (Opposite Direction) upside down
        //normalFactor = pow(normalFactor, 2.0); // Sharper falloff on slopes
        vec3 n = normalize(Normal_worldspace);
        float normalFactor = max(dot(n, vec3(0, 1, 0)), 0.0);
        // Snow starts at cos=0.3 slopes and is full at 0-degree slopes
        float lowThreshold = 0.3;  // Snow starts appearing
        float highThreshold = 0.8; // Snow is fully opaque
        normalFactor = smoothstep(lowThreshold, highThreshold, normalFactor);
        // Calculate final snow coverage
        float snowCoverage = skyVisible * normalFactor * snowAmount;

        // Blend base color with snow
        //vec3 snowColor = vec3(0.95, 0.96, 0.98); // Slightly blue-white

        vec3 snowTextureColor = texture(snowTex, vertex_UV_tiled * 2.0).rgb;
        vec3 snowColor=snowTextureColor.rgb;
        _Kd.rgb = mix(_Kd.rgb, snowColor, snowCoverage);
        _Ka.rgb = mix(_Ka.rgb, snowColor * 0.6, snowCoverage);
        _Ks.rgb = mix(_Ks.rgb, vec3(0.6), snowCoverage); // Snow is reflective
        _Ns = mix(_Ns, 10.0, snowCoverage); // Increase shininess
    }


    // Phong Reflection Model
    // 1. Ambient
    vec4 Ia = lightData.La * _Ka;

    // 2. Diffuse
    vec4 N = normalize(vertex_normal_cameraspace); 
    // CRITICAL CHANGE: Use the specific lightPosCamera passed as argument
    //vec4 L = normalize(lightPosCamera - vertex_position_cameraspace);
    vec4 L = normalize(vec4(lightDir_cameraspace, 0.0)); //+ or -?

    float cosTheta = clamp(dot(N, L), 0, 1);
    vec4 Id = lightData.Ld * _Kd * cosTheta;

    // 3. Specular
    vec4 R = reflect(-L, N);
    vec4 E = normalize(vec4(0, 0, 0, 1) - vertex_position_cameraspace);
    float cosAlpha = clamp(dot(E, R), 0, 1);
    float specular_factor = pow(cosAlpha, _Ns);
    vec4 Is = lightData.Ls * _Ks * specular_factor;

    // Apply visibility to Diffuse and Specular only (Ambient is usually constant)
    // Note: Some prefer to apply shadows to Ambient too, but standard Phong usually doesn't.
    vec4 combinedColor = Ia + (Id * visibility) + (Is * visibility);

    return combinedColor.rgb;
    
}

