#version 330 core

// Input vertex data, different for all executions of this shader.
layout(location = 0) in vec3 vertexPosition_modelspace;
// ===== ADD INSTANCING ATTRIBUTES =====
layout(location = 4) in vec4 instanceMatrix_row0;
layout(location = 5) in vec4 instanceMatrix_row1;
layout(location = 6) in vec4 instanceMatrix_row2;
layout(location = 7) in vec4 instanceMatrix_row3;
layout(location = 8) in int instanceTextureIndex;
// =====================================
// Wind Uniforms
uniform int windStrength;
uniform float time;
uniform bool useInstancing; 

// Values that stay constant for the whole mesh.
uniform mat4 VP;
//uniform mat4 VP2;
uniform mat4 M;


void main() {
    // ===== DETECT INSTANCING =====
    //bool isInstanced = (dot(instanceMatrix_row0, instanceMatrix_row0) > 0.0001);
    
    mat4 modelMatrix;
    //if (isInstanced) {
    if (useInstancing) {
        modelMatrix = mat4(
            instanceMatrix_row0,
            instanceMatrix_row1,
            instanceMatrix_row2,
            instanceMatrix_row3
        );
    } else {
        modelMatrix = M;
    }
    // =============================
    vec3 pos = vertexPosition_modelspace;
    // Apply EXACT SAME wind logic as lighting shader
    if (useInstancing && windStrength > 0) {
        float phaseOffset = modelMatrix[3].x + modelMatrix[3].z;
        float swayFactor = pos.y * float(windStrength) * 0.05; 
        float wave = sin(time * 2.0 + phaseOffset);
        
        pos.x += wave * swayFactor;
        pos.z += wave * swayFactor * 0.5;
    }
    // Transform to light space
    gl_Position = VP * modelMatrix * vec4(pos, 1.0);
    //gl_Position = VP * modelMatrix * vec4(vertexPosition_modelspace, 1.0);
}


