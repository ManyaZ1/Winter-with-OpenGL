#version 330 core

layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;
layout(location = 2) in vec2 vertexUV;
// ===== ADD THESE NEW INSTANCING ATTRIBUTES =====
// Per-instance model matrix (4 vec4s = mat4)
layout(location = 4) in vec4 instanceMatrix_row0;
layout(location = 5) in vec4 instanceMatrix_row1;
layout(location = 6) in vec4 instanceMatrix_row2;
layout(location = 7) in vec4 instanceMatrix_row3;
// Per-instance texture index
layout(location = 8) in int instanceTextureIndex;
uniform int useTexture;

uniform bool useInstancing; 
uniform int windStrength ;
uniform float x_bias;
uniform float z_bias;
uniform float time;
uniform mat4 skyVP;
uniform sampler2D snowAccumMap;
uniform float snowAmount; // 0.0 to 1.0
uniform sampler2D maskTex;      // White = lake

// ================================================


// Phong 
// light properties
struct Light {
    vec4 La;
    vec4 Ld;
    vec4 Ls;
    vec3 lightPosition_worldspace;
};
uniform Light light;
uniform float scaling_factor;
uniform mat4 P;
uniform mat4 V;
uniform mat4 M;
uniform vec3 lightDirection_worldspace;

uniform mat4 lightVP;
uniform mat4 light2VP; // hw 2
//out vec4 light_position_cameraspace2;
uniform Light light2; 
out vec4 vertex_position_cameraspace;
out vec4 vertex_normal_cameraspace;
//out vec4 light_position_cameraspace; directional!!!
out vec3 lightDir_cameraspace;

out vec2 vertex_UV;
out vec4 vertex_position_lightspace;
//out vec4 vertex_position_lightspace2;
out vec2 worldUV;
uniform float normDir;
uniform vec2 uvScale; 
out vec2 vertex_UV_tiled;
out vec3 fragPos_modelspace;
out vec3 vertex_position_worldspace;
out vec3 Normal_worldspace;
// ===== ADD THIS NEW OUTPUT FOR FRAGMENT SHADER =====
flat out int textureIndex;
// ===================================================


// Source - https://stackoverflow.com/a
// Posted by HuaTham, modified by community. See post 'Timeline' for change history
// Retrieved 2025-12-07, License - CC BY-SA 3.0

float atan2(in float y, in float x)
{
    float PI = 3.14159265359;
    bool s = (abs(x) > abs(y));
    return x == 0.0 ? sign(y)*PI/2 : atan(y, x);
    //return mix(PI/2.0 - atan(x,y), atan(y,x), s);
}

//TREE
// PHYSICS UNIFORMS
uniform vec3 nodePositions[4]; 
const float treeTotalHeight = 10.0;

void main() {
    // Detect if this is an instanced draw by checking if instance matrix is non-zero
    //bool isInstanced = (dot(instanceMatrix_row0, instanceMatrix_row0) > 0.0001);
    // Choose which model matrix to use
    mat4 modelMatrix;
    //if (isInstanced) {
    if (useInstancing) {
        // Construct model matrix from instance attributes
        modelMatrix = mat4(
            instanceMatrix_row0,
            instanceMatrix_row1,
            instanceMatrix_row2,
            instanceMatrix_row3
        );
        textureIndex = instanceTextureIndex;
    } else {
        // Use uniform model matrix for non-instanced objects
        modelMatrix = M;
        textureIndex = 0; // Default for non-instanced
    }

    vec3 lightDir_world = normalize(-lightDirection_worldspace);
    lightDir_cameraspace = normalize((V * vec4(lightDir_world, 0.0)).xyz);

   // ===== SKY DOME SECTION =====
   if (useTexture == 3) { //spherical mapping for sky dome
        // position for rasterizer
        gl_Position = P * V * modelMatrix * vec4(vertexPosition_modelspace, 1.0);

        // pass model-space position to fragment so we can compute UVs per-fragment
        fragPos_modelspace = vertexPosition_modelspace;

        //  vertex_UV as placeholder but but not used 
        vertex_UV = vec2(0.0);
        return;
    }

    vec3 pos = vertexPosition_modelspace;
    // ===== WIND LOGIC =====
    if(windStrength>0){
        float phaseOffset = modelMatrix[3].x + modelMatrix[3].z; //unique gia ka8e object
        float swayFactor = pos.y * float(windStrength) * 0.01; // oso pio pshla toso pio entono
        float wave_x = sin(time * 2.0 + phaseOffset)  * (1.0+x_bias)      ; 
        float wave_z = cos(time * 1.5 + phaseOffset*1.5) * (1.0+z_bias)   ;
        if (useInstancing){
            // Apply displacement to X and Z coordinates
            pos.x += wave_x * swayFactor;
            pos.z += wave_z * swayFactor ;
        }
        if (windStrength> 0 && useTexture == 7 && !useInstancing){//bear,deer and not instancing therefore not 
            pos.x += wave_x *  swayFactor *0.1  ;// * x_bias
            pos.z += wave_z * swayFactor *0.1 ;// * z_bias
        }
    }
    //make animals breathe
    if (useTexture==7 && !useInstancing){
        float breatheFactor = pos.y * 0.01; // oso pio pshla toso pio entono
        float breathe = sin(time *3.0) *breatheFactor* 0.5;
        pos.y += breathe;
    }
    //else {
        
    // Output position of the vertex
    //gl_Position = P * V * modelMatrix * vec4(vertexPosition_modelspace, 1);
    gl_Position = P * V * modelMatrix * vec4(pos, 1.0);
    vertex_position_cameraspace = V * modelMatrix * vec4(vertexPosition_modelspace, 1);
    vertex_normal_cameraspace = mat4(transpose(inverse(mat3(V * modelMatrix)))) * vec4(vertexNormal_modelspace, 0);
    vertex_UV = vertexUV;
    
    vertex_position_lightspace = lightVP * modelMatrix * vec4(vertexPosition_modelspace, 1);
    //}
    vertex_UV_tiled = vertexUV * uvScale;

    vec4 worldPos = M * vec4(vertexPosition_modelspace, 1.0);

    // --- SNOW INFLATION LOGIC ONLY FOR TERRAIN---
    float maskValue = texture(maskTex, vertex_UV).r;
    if(snowAmount> 0.4 && useTexture==1 && maskValue<0.5){
    // 1. Project vertex to sky-space to check visibility
    vec4 fragPosSky = skyVP * worldPos;
    vec3 skyCoords = (fragPosSky.xyz / fragPosSky.w) * 0.5 + 0.5;
    float skyDepth = texture(snowAccumMap, skyCoords.xy).r;
    float fragDepth = skyCoords.z;
    
    // Is this vertex hit by snow?
    float skyVisible = (fragDepth - 0.01) < skyDepth ? 1.0 : 0.0;
    
    // 2. Normal check (consistent with fragment shader)
    vec3 n = normalize(mat3(modelMatrix) * vertexNormal_modelspace);
    float normalFactor = max(dot(n, vec3(0, 1, 0)), 0.0);
    // If the surface is perfectly flat (like a floor), the dot product is 1.0.
    //If the surface is a vertical wall, the dot product is 0.0.
    normalFactor = smoothstep(0.3, 0.8, normalFactor);
    
    float weight = skyVisible * normalFactor * snowAmount;

    // 3. Taubin-lite "Valley Filling"
    // Valleys usually have smaller/divergent normals or lower Y. 
    // For a simple vertex shader, we scale displacement by (1.0 - normalFactor) 
    // so that flat areas (valleys) get MORE height than steep peaks.
    float inflationAmount = weight * 0.5; // Adjust 0.5 for max snow thickness
    
    // Offset position ALONG the world up vector or normal
    // Using vec3(0,1,0) mimics snow "stacking" upwards
    worldPos.y += inflationAmount; 

    // Update gl_Position with the new snow-height world position
    gl_Position = P * V * worldPos;
    }

    vertex_position_worldspace = worldPos.xyz; // Pass to fragment shader
    Normal_worldspace = normalize(mat3(M) * vertexNormal_modelspace);
}

